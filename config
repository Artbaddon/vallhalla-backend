server {
server_name puertdelalamedavalhalla.app;

root /var/ww/valhalla_front;
index index.html;

location / {
try_files $uri /index.html;

location /api/ {
proxy_pass http://localhost:3000/api/;
proxy_http_version 1.1;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection 'upgrade';
proxy_set_header Host $host;
proxy_cache_bypass $http_upgrade;

error_log /var/log/nginx/valhalla_error.log;
access_log /var/log/nginx/valhalla_access.log;

listen 443 ssl; # managed by Certbot
ssl_certificate /etc/letsencrypt/live/puertdelalamedavalhalla.app/fullchain.pem; # managed by Certbot
ssl_certificate_key /etc/letsencrypt/live/puertdelalamedavalhalla.app/privkey.pem; # managed by Certbot
include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

server
if

} # managed by Certbot

listen 80;
server_name puertdelalamedavalhalla.app;
return 404; # managed by Certbot